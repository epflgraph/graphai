# Image tags
GRAPH_IMAGE=graphai-self-contained:latest
RABBITMQ_IMAGE=rabbitmq:3.13-management
REDIS_IMAGE=redis:7
MYSQL_IMAGE=mysql:8.4
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
PROMTAIL_IMAGE=grafana/promtail:2.9.10

# API
API_HOST=0.0.0.0
API_PORT=28800
API_WORKERS=1
API_FORWARDED_ALLOW_IPS=*

# Compose profiles:
# - GPU machines: COMPOSE_PROFILES=gpu
# - CPU-only machines: COMPOSE_PROFILES=cpu-fallback
# - Local MySQL/ES from containers: add local-infra
# - Add observability when needed: COMPOSE_PROFILES=gpu,observability
COMPOSE_PROFILES=cpu-fallback

# Broker/backend
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=graphai
MYSQL_USER=graphai
MYSQL_PASSWORD=graphai
# DB_HOST can be either:
# - mysql (when COMPOSE_PROFILES includes local-infra)
# - external VM IP/FQDN (when MySQL runs outside Docker)
DB_HOST=mysql
DB_PORT=3306
DB_USER=graphai
DB_PASSWORD=graphai

# Elasticsearch
# ES_HOST can be either:
# - elasticsearch (when COMPOSE_PROFILES includes local-infra)
# - external VM IP/FQDN (when Elasticsearch runs outside Docker)
ES_HOST=elasticsearch
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Runtime paths in container
NLTK_DATA=/opt/nltk_data
CACHE_ROOT=/var/graphai/storage
LOG_PATH=/var/graphai/logs
WHISPER_MODEL_PATH=/opt/models/whisper
HUGGINGFACE_MODEL_PATH=/opt/models/huggingface
FASTTEXT_MODEL_PATH=/opt/models/fasttext

# GPU assignment
GPU0_ID=0
GPU1_ID=1
GPU2_ID=2
GPU3_ID=3

# Worker tuning (mirrors your systemd defaults)
CELERY_CPU_CACHE_POOL=prefork
CELERY_CPU_CACHE_CONCURRENCY=8
CELERY_CPU_CACHE_PREFETCH=1
CELERY_CPU_CACHE_NAME=RCP_CPUx8_Cache

CELERY_CPU_RAG_POOL=prefork
CELERY_CPU_RAG_CONCURRENCY=8
CELERY_CPU_RAG_PREFETCH=1
CELERY_CPU_RAG_NAME=RCP_CPUx8_Rag

CELERY_CPU_IMG_POOL=prefork
CELERY_CPU_IMG_CONCURRENCY=8
CELERY_CPU_IMG_PREFETCH=1
CELERY_CPU_IMG_NAME=RCP_CPUx8_Img

CELERY_CPU_EMBED_POOL=prefork
CELERY_CPU_EMBED_CONCURRENCY=6
CELERY_CPU_EMBED_PREFETCH=1
CELERY_CPU_EMBED_NAME=RCP_CPUx6_Embedding

CELERY_CPU_TEXT_POOL=prefork
CELERY_CPU_TEXT_CONCURRENCY=16
CELERY_CPU_TEXT_PREFETCH=16
CELERY_CPU_TEXT_NAME=RCP_CPUx16_Text

CELERY_CPU_VVT_POOL=prefork
CELERY_CPU_VVT_CONCURRENCY=6
CELERY_CPU_VVT_PREFETCH=1
CELERY_CPU_VVT_NAME=RCP_CPUx6_Video_Voice_Transl

CELERY_CPU_MISC_POOL=prefork
CELERY_CPU_MISC_CONCURRENCY=2
CELERY_CPU_MISC_PREFETCH=1
CELERY_CPU_MISC_NAME=RCP_CPUx6_Ontl_Scrp_Celery

CELERY_GPU_EMBED_CONCURRENCY=1
CELERY_GPU_EMBED_NAME=RCP_GPU0_Embedding
CELERY_GPU_VOICE1_CONCURRENCY=1
CELERY_GPU_VOICE1_NAME=RCP_GPU1_Voice
CELERY_GPU_VOICE2_CONCURRENCY=1
CELERY_GPU_VOICE2_NAME=RCP_GPU2_Voice
CELERY_GPU_TRANSL_CONCURRENCY=1
CELERY_GPU_TRANSL_NAME=RCP_GPU3_Translation

# CPU fallback workers for GPU queues (used when COMPOSE_PROFILES=cpu-fallback)
CELERY_CPU_FALLBACK_EMBED_POOL=prefork
CELERY_CPU_FALLBACK_EMBED_CONCURRENCY=1
CELERY_CPU_FALLBACK_EMBED_PREFETCH=1
CELERY_CPU_FALLBACK_EMBED_NAME=RCP_CPU_Fallback_Embedding_GPUQ

CELERY_CPU_FALLBACK_VOICE_POOL=prefork
CELERY_CPU_FALLBACK_VOICE_CONCURRENCY=2
CELERY_CPU_FALLBACK_VOICE_PREFETCH=1
CELERY_CPU_FALLBACK_VOICE_NAME=RCP_CPU_Fallback_Voice_GPUQ

CELERY_CPU_FALLBACK_TRANSL_POOL=prefork
CELERY_CPU_FALLBACK_TRANSL_CONCURRENCY=1
CELERY_CPU_FALLBACK_TRANSL_PREFETCH=1
CELERY_CPU_FALLBACK_TRANSL_NAME=RCP_CPU_Fallback_Translation_GPUQ
