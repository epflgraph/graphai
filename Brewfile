# Brewfile
# This file is used by Homebrew to manage packages.
# To install the packages listed in this file, run:
#   brew bundle

# Install "jq" for JSON printing and processing
brew "jq"

# Install "ffmpeg" for multimedia processing
brew "ffmpeg"

# Install "tesseract" for OCR (Optical Character Recognition)
brew "tesseract"

# Install "imagemagick" for image manipulation
brew "imagemagick"

# Install "poppler" for PDF rendering and manipulation
brew "poppler"

# Install "chromaprint" for audio fingerprinting
brew "chromaprint"

# Install "leptonica" for image processing library
brew "leptonica"

# Install "ghostscript" for PostScript and PDF processing
brew "ghostscript"

# Install image libraries
brew "libjpeg"
brew "libpng"
brew "libtiff"
brew "freetype"
