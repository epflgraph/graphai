########################################
# 🧠 Core Image
########################################

GRAPH_IMAGE=epflgraph/graphai:latest
RABBITMQ_IMAGE=rabbitmq:3.13-management
REDIS_IMAGE=redis:7
PROMTAIL_IMAGE=grafana/promtail:2.9.10


########################################
# 🌐 API
########################################

API_HOST=0.0.0.0
API_PORT=28800
API_WORKERS=1
API_PROXY_HEADERS=1
API_FORWARDED_ALLOW_IPS=*
API_TITLE=GraphAI API - Local deployment with Docker 🐳


########################################
# 🧩 Compose profiles
########################################

# GPU machines: gpu
# CPU-only machines: cpu-fallback
# Add scheduler when needed: scheduler
# Add ops tools when needed: ops
# Add observability when needed: observability
# Add nginx reverse proxy when needed: proxy
COMPOSE_PROFILES=cpu-fallback


########################################
# 🧵 Celery / Messaging
########################################

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_LOG_LEVEL=info

# required for celery running as root in this image
C_FORCE_ROOT=1


########################################
# 🧠 CPU Workers
########################################

# Cache
CELERY_CPU_CACHE_CONCURRENCY=1
CELERY_CPU_CACHE_PREFETCH=1
CELERY_CPU_CACHE_POOL=prefork
CELERY_CPU_CACHE_NAME=RCP_CPUx1_Cache

# RAG
CELERY_CPU_RAG_CONCURRENCY=1
CELERY_CPU_RAG_PREFETCH=1
CELERY_CPU_RAG_POOL=prefork
CELERY_CPU_RAG_NAME=RCP_CPUx1_Rag

# Image
CELERY_CPU_IMG_CONCURRENCY=1
CELERY_CPU_IMG_PREFETCH=1
CELERY_CPU_IMG_POOL=prefork
CELERY_CPU_IMG_NAME=RCP_CPUx1_Img

# Embedding
CELERY_CPU_EMBED_CONCURRENCY=1
CELERY_CPU_EMBED_PREFETCH=1
CELERY_CPU_EMBED_POOL=prefork
CELERY_CPU_EMBED_NAME=RCP_CPUx1_Embedding

# Text
CELERY_CPU_TEXT_CONCURRENCY=1
CELERY_CPU_TEXT_PREFETCH=1
CELERY_CPU_TEXT_POOL=prefork
CELERY_CPU_TEXT_NAME=RCP_CPUx1_Text

# Video / Voice / Translation
CELERY_CPU_VVT_CONCURRENCY=1
CELERY_CPU_VVT_PREFETCH=1
CELERY_CPU_VVT_POOL=prefork
CELERY_CPU_VVT_NAME=RCP_CPUx1_Video_Voice_Transl

# Ontology / Scraping / Celery
CELERY_CPU_MISC_CONCURRENCY=1
CELERY_CPU_MISC_PREFETCH=1
CELERY_CPU_MISC_POOL=prefork
CELERY_CPU_MISC_NAME=RCP_CPUx1_Ontl_Scrp_Celery


########################################
# 🚀 GPU Workers
########################################

GPU0_ID=0
GPU1_ID=1
GPU2_ID=2
GPU3_ID=3

CELERY_GPU_EMBED_CONCURRENCY=1
CELERY_GPU_EMBED_NAME=RCP_GPU0_Embedding

CELERY_GPU_VOICE1_CONCURRENCY=1
CELERY_GPU_VOICE1_NAME=RCP_GPU1_Voice

CELERY_GPU_VOICE2_CONCURRENCY=1
CELERY_GPU_VOICE2_NAME=RCP_GPU2_Voice

CELERY_GPU_TRANSL_CONCURRENCY=1
CELERY_GPU_TRANSL_NAME=RCP_GPU3_Translation


########################################
# 🧯 CPU fallback for GPU queues
########################################

CELERY_CPU_FALLBACK_EMBED_POOL=prefork
CELERY_CPU_FALLBACK_EMBED_CONCURRENCY=1
CELERY_CPU_FALLBACK_EMBED_PREFETCH=1
CELERY_CPU_FALLBACK_EMBED_NAME=RCP_CPU_Fallback_Embedding_GPUQ

CELERY_CPU_FALLBACK_VOICE_POOL=prefork
CELERY_CPU_FALLBACK_VOICE_CONCURRENCY=1
CELERY_CPU_FALLBACK_VOICE_PREFETCH=1
CELERY_CPU_FALLBACK_VOICE_NAME=RCP_CPU_Fallback_Voice_GPUQ

CELERY_CPU_FALLBACK_TRANSL_POOL=prefork
CELERY_CPU_FALLBACK_TRANSL_CONCURRENCY=1
CELERY_CPU_FALLBACK_TRANSL_PREFETCH=1
CELERY_CPU_FALLBACK_TRANSL_NAME=RCP_CPU_Fallback_Translation_GPUQ


########################################
# 🌸 Flower (optional)
########################################

FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:admin


########################################
# 🗄️ Storage paths (inside container)
########################################

GRAPH_CACHE_ROOT=/var/graphai/storage
GRAPH_LOG_ROOT=/var/graphai/logs

WHISPER_MODEL_ROOT=/opt/models/whisper
HF_HOME=/opt/models/huggingface
SENTENCE_TRANSFORMERS_HOME=/opt/models/huggingface
FASTTEXT_MODEL_ROOT=/opt/models/fasttext

NLTK_DATA=/opt/nltk_data


########################################
# 📦 Host storage paths (outside container)
########################################

HOST_CACHE_DIR=/path/to/cache/graphai
HOST_LOG_DIR=/path/to/logs/graphai


########################################
# 🧩 External services
########################################

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=...
DB_PASSWORD=...

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=...
ES_PASSWORD=...
ES_CAFILE=/app/certs/graph-engine-elasticsearch.crt


########################################
# 📊 Observability / exporters
########################################

CELERY_EXPORTER_PORT=9808
DOCKER_STATS_EXPORTER_PORT=9417
NVIDIA_GPU_EXPORTER_PORT=9400


########################################
# 🧪 Optional tools
########################################

REDIS_COMMANDER_PORT=8081
